# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
config/tenants/          # per-tenant overrides, §25
eval/golden/
eval/regression/
eval/adversarial/
eval/canaries/           # per-tenant canary strings, §20.2
corpora/
adapters/
*.safetensors
*.bin
*.pt
*.ckpt

